{
  "cleanUrls": true,
  "trailingSlash": false,

  "rewrites": [
    { "source": "/news",                    "destination": "/news.html" },
    { "source": "/news/",                   "destination": "/news.html" },
    { "source": "/news/:slug",              "destination": "/article.html?slug=:slug" },
    { "source": "/admin",                   "destination": "/admin.html" }
  ],

  "redirects": [
    { "source": "/index.html",              "destination": "/",          "permanent": true },
    { "source": "/news.html",               "destination": "/news/",     "permanent": true },
    { "source": "/article.html",            "destination": "/news/",     "permanent": true }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",            "value": "nosniff" },
        { "key": "X-Frame-Options",                   "value": "DENY" },
        { "key": "Referrer-Policy",                   "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",                "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-DNS-Prefetch-Control",            "value": "on" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag",                      "value": "noindex, nofollow" },
        { "key": "Cache-Control",                      "value": "no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag",                      "value": "noindex, nofollow" },
        { "key": "Cache-Control",                      "value": "no-store" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type",                       "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control",                      "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control",                      "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/:path.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2)",
      "headers": [
        { "key": "Cache-Control",                      "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
